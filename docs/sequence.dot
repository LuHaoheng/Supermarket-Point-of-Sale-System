digraph G {graph [rankdir=LR,bgcolor=white,ranksep=.5];node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fillcolor="#E9F3FB",color="#3C719B"];"Cashier" -> "PosFrame" [label="checkout(cart, cash)"];"PosFrame" -> "PosService" [label="checkout(cart, cash)"];"PosService" -> "Product" [label="validate stock / price"];"PosService" -> "Database" [label="copy, decrement, persist"];"Database" -> "PosService" [label="committed Sale"];"PosService" -> "PosFrame" [label="Sale / receipt text"];"PosFrame" -> "Cashier" [label="show receipt + change"]; }