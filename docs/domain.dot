digraph G {graph [rankdir=LR,bgcolor=white,nodesep=.5,ranksep=.65];node [shape=record,fontname="DejaVu Sans",style=filled,fillcolor="#EAF3FA",color="#285684"]; Product [label="{Product|sku : String\lname : String\lprice : BigDecimal\lquantity : int\l}"];Sale [label="{Sale|id : String\ltime : LocalDateTime\llines : Map\lprices : Map\ltotal : BigDecimal\lreturned : Map\l}"];Return [label="{ReturnRecord|id : String\lsaleId : String\lsku : String\lquantity : int\lrefund : BigDecimal\l}"];DB [label="{Database|products\lsales\lreturns\l}"];DB -> Product [label="1 to many"];DB -> Sale [label="1 to many"];DB -> Return [label="1 to many"]; Sale -> Product [label="sales lines / SKU"];Return -> Sale [label="original sale"];Return -> Product [label="returned SKU"]; }