digraph G {graph [rankdir=LR,bgcolor=white,ranksep=.6];node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fillcolor="#E9F3FB",color="#3C719B"];"Cashier" -> "PosFrame" [label="sale ID, SKU, qty"];"PosFrame" -> "PosService" [label="refund(...)"];"PosService" -> "Sale" [label="check remaining returnable qty"];"PosService" -> "Database" [label="restore stock + save return"];"Database" -> "PosService" [label="ReturnRecord"];"PosService" -> "PosFrame" [label="refund amount / receipt"]; }