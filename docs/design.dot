digraph G {graph [rankdir=LR,bgcolor=white,nodesep=.5,ranksep=.8];node [shape=record,fontname="DejaVu Sans",style=filled,fillcolor="#EAF3FA",color="#285684"];"PosFrame" [label="{PosFrame|cart: Map\linventoryModel\l|refreshAll()\lshowReceipt()\l}"];"PosService" [label="{PosService|db: Database\lfile: Path\l|checkout()\lrefund()\laddProduct()\lrestock()\l}"];"Database" [label="{Database|products: Map\lsales: Map\lreturns: List\l|load()\lsave()\l}"];"Sale" [label="{Sale|lines, prices, returned\l|returnable(sku)\l}"];"Product" [label="{Product|sku, price, quantity\l|adjust(diff)\l}"];"ReturnRecord" [label="{ReturnRecord|saleId, sku, quantity, refund\l}"];"PosFrame" -> "PosService";"PosService" -> "Database";"Database" -> "Product";"Database" -> "Sale";"Database" -> "ReturnRecord";}